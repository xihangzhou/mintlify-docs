{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "VMEG Open API",
  "colors": {
    "primary": "#7B4DFF",
    "light": "#9B7AFF",
    "dark": "#6239CC"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "index",
                  "guides/quickstart",
                  "guides/authentication"
                ]
              },
              {
                "group": "Core concepts",
                "pages": [
                  "guides/errors",
                  "guides/idempotency",
                  "guides/webhooks"
                ]
              },
              {
                "group": "Workflows",
                "pages": [
                  "guides/materials",
                  "guides/media-translation"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "groups": [
              {
                "group": "Overview",
                "pages": ["api-reference/introduction"]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "api-reference/openapi.json",
                  "directory": "api-reference"
                }
              }
            ]
          }
        ]
      },
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "指南",
            "groups": [
              {
                "group": "快速开始",
                "pages": [
                  "zh/index",
                  "zh/guides/quickstart",
                  "zh/guides/authentication"
                ]
              },
              {
                "group": "核心概念",
                "pages": [
                  "zh/guides/errors",
                  "zh/guides/idempotency",
                  "zh/guides/webhooks"
                ]
              },
              {
                "group": "工作流",
                "pages": [
                  "zh/guides/materials",
                  "zh/guides/media-translation"
                ]
              }
            ]
          },
          {
            "tab": "API 参考",
            "groups": [
              {
                "group": "概览",
                "pages": ["zh/api-reference/introduction"]
              },
              {
                "group": "接口",
                "openapi": {
                  "source": "zh/api-reference/openapi.json",
                  "directory": "zh/api-reference"
                }
              }
            ]
          }
        ],
        "navbar": {
          "links": [
            {
              "label": "帮助中心",
              "href": "https://www.vmeg.ai/help-center/"
            }
          ],
          "primary": {
            "type": "button",
            "label": "获取 API Key",
            "href": "https://www.vmeg.ai/signIn?redirect=%2Fopen-api-setting"
          }
        }
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://www.vmeg.ai/home",
          "icon": "grid-2"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Help center",
        "href": "https://www.vmeg.ai/help-center/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://www.vmeg.ai/signIn?redirect=%2Fopen-api-setting"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "mdx": {
      "server": "https://api.vmeg.ai"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"]
  }
}

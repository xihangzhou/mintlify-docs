{
  "openapi": "3.1.0",
  "info": {
    "title": "VMEG Open API",
    "description": "VMEG 公开 Open API，支持 TTS、文本翻译、媒体翻译、声音克隆与资产管理。响应格式为 `{ code, message, data }`；`code === 200` 表示成功。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.vmeg.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "TTS",
      "description": "Speech synthesis tasks (sync and async)"
    },
    {
      "name": "Text translation",
      "description": "Atomic text translation tasks"
    },
    {
      "name": "Voice clone",
      "description": "Voice cloning tasks"
    },
    {
      "name": "Media translation",
      "description": "Async video and audio translation tasks"
    },
    {
      "name": "Task management",
      "description": "List, detail, and delete submitted tasks"
    },
    {
      "name": "Assets - Materials",
      "description": "CDN direct upload, multipart upload, list, and delete"
    },
    {
      "name": "Assets - Voices",
      "description": "System and cloned voices"
    }
  ],
  "paths": {
    "/openapi/task/tts/create": {
      "post": {
        "tags": [
          "TTS"
        ],
        "summary": "创建 TTS 任务（同步）",
        "description": "调用 vmeg-tts Lambda（RequestResponse），同步返回合成结果。",
        "operationId": "ttsCreateSync",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenApiTtsCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiTtsCreateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/task/tts/create-async": {
      "post": {
        "tags": [
          "TTS"
        ],
        "summary": "创建 TTS 任务（异步）",
        "description": "调用 vmeg-tts Lambda（Event），仅返回 taskId；结果通过回调投递。",
        "operationId": "ttsCreateAsync",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKeyRequired"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenApiTtsCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已接受",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiTtsCreateResponse"
                }
              }
            }
          }
        }
      }
    },

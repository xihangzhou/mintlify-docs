  "webhooks": {
    "taskCallback": {
      "post": {
        "tags": [
          "Webhook"
        ],
        "summary": "任务完成回调（由 VMEG 发送至你的 URL）",
        "description": "异步任务完成后，VMEG 向配置的 Webhook URL 发送 POST，并附带 X-Timestamp 与 X-Signature（HMAC-SHA256）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenApiCallbackDispatchBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "接收成功（请返回 2xx）"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "项目 API Key：`Authorization: Bearer <api_key>`"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "X-Idempotency-Key",
        "in": "header",
        "description": "幂等键（异步创建必填，最长 64 字符）",
        "schema": {
          "type": "string",
          "maxLength": 64
        }
      },
      "IdempotencyKeyRequired": {
        "name": "X-Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "幂等键（必填，最长 64 字符）",
        "schema": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "schemas": {
      "OpenApiResponseBase": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务码；200 表示成功"
          },
          "message": {
            "type": "string",
            "example": ""
          }
        },
        "required": [
          "code"
        ]
      },
      "OpenApiVoidResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OpenApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "nullable": true
              }
            }
          }
        ]
      },
      "OpenApiTaskType": {
        "type": "string",
        "enum": [
          "VIDEO_TRANSLATION",
          "AUDIO_TRANSLATION",
          "SUBTITLE_TRANSLATION",
          "TTS",
          "CLONE_VOICE",
          "TEXT_TRANSLATION"
        ]
      },
      "OpenApiTtsCreateRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "example": "V1",
            "description": "引擎代码：V1-V5，或 MM/V2/CB/IT/CVC 等"
          },
          "language": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "example": "en-US"
              }
            }
          },
          "trim": {
            "type": "boolean",
            "default": false
          },
          "data": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/OpenApiTtsDataItem"
            }
          },
          "outputFormat": {
            "type": "string",
            "enum": [
              "wav",
              "mp3",
              "m4a"
            ],
            "default": "m4a"
          },
          "extraData": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "OpenApiTtsDataItem": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
